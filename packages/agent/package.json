{
  "name": "agent",
  "version": "0.1.0-issus.1",
  "private": true,
  "type": "module",
  "main": "./dist/common/index.js",
  "module": "./dist/common/index.js",
  "types": "./dist/common/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./front": {
      "types": "./dist/front/index.d.ts",
      "import": "./dist/front/index.js"
    },
    "./broker": {
      "types": "./dist/broker/index.d.ts",
      "import": "./dist/broker/index.js"
    },
    "./broker/worker": {
      "types": "./dist/broker/worker/index.d.ts",
      "import": "./dist/broker/worker/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node ../../scripts/run-tests.mjs src",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:integration": "node ../../scripts/run-tests.mjs tests/integration"
  },
  "dependencies": {
    "pg": "8.23.1",
    "ws": "8.22.0",
    "env-schema": "8.0.1"
  },
  "peerDependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "express": "5.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
