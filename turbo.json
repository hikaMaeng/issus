{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../tsconfig.json",
        "../../scripts/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../tsconfig.json",
        "../../scripts/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../scripts/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "ISSUS_TEST_DATABASE_URL",
        "ISSUS_TEST_SERVER_URL",
        "USERNAME",
        "USERPROFILE",
        "USERDOMAIN",
        "HOME",
        "APPDATA",
        "LOCALAPPDATA",
        "TEMP",
        "TMP",
        "ISSUS_TEST_SCHEMA",
        "ISSUS_TEST_BROKER_SCHEMA",
        "ISSUS_TEST_BOOTSTRAP_TOKEN",
        "ISSUS_TEST_OWNER",
        "HEADLESS_BROWSER_PLAYWRIGHT_ROOT",
        "ISSUS_TEST_CLI_RUN_MODULE"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "ISSUS_TEST_DATABASE_URL",
        "ISSUS_TEST_SERVER_URL",
        "USERNAME",
        "USERPROFILE",
        "USERDOMAIN",
        "HOME",
        "APPDATA",
        "LOCALAPPDATA",
        "TEMP",
        "TMP",
        "ISSUS_TEST_SCHEMA",
        "ISSUS_TEST_BROKER_SCHEMA",
        "ISSUS_TEST_BOOTSTRAP_TOKEN",
        "ISSUS_TEST_OWNER",
        "HEADLESS_BROWSER_PLAYWRIGHT_ROOT",
        "ISSUS_TEST_CLI_RUN_MODULE"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "ISSUS_TEST_DATABASE_URL",
        "ISSUS_TEST_SERVER_URL",
        "USERNAME",
        "USERPROFILE",
        "USERDOMAIN",
        "HOME",
        "APPDATA",
        "LOCALAPPDATA",
        "TEMP",
        "TMP",
        "ISSUS_TEST_SCHEMA",
        "ISSUS_TEST_BROKER_SCHEMA",
        "ISSUS_TEST_BOOTSTRAP_TOKEN",
        "ISSUS_TEST_OWNER",
        "HEADLESS_BROWSER_PLAYWRIGHT_ROOT",
        "ISSUS_TEST_CLI_RUN_MODULE"
      ]
    }
  }
}
