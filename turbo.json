{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../tsconfig.json",
        "../../scripts/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../tsconfig.json",
        "../../scripts/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../scripts/**"
      ],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "ISSUS_TEST_DATABASE_URL",
        "ISSUS_TEST_SERVER_URL"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "^build",
        "build"
      ],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "ISSUS_TEST_DATABASE_URL",
        "ISSUS_TEST_SERVER_URL"
      ]
    }
  }
}
