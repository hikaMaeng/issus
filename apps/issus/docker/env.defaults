HOST=0.0.0.0
PORT=18140
DATABASE_URL=postgresql://issus@issus-db:5432/issus
ISSUS_OWNER=hikaMaeng
ISSUS_BOOTSTRAP_TOKEN_FILE=/run/secrets/issus-bootstrap-token
ISSUS_ALLOWED_ORIGIN=http://127.0.0.1:18140
AGENT_DATABASE_POOL_MAX=4
QUEUE_VISIBILITY_TIMEOUT_SECONDS=60
AGENT_EXECUTION_LEASE_SECONDS=120
ISSUS_EVENT_RETENTION_DAYS=null
ISSUS_SCHEDULE_TICK_MS=5000
ISSUS_WAKE_ADAPTER=disabled
# ISSUS_BOOTSTRAP_TOKEN_FILE must point to an operator-mounted read-only secret.
AGENT_QUEUE=issus_intake
QUEUE_POLL_SECONDS=1
