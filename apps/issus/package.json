{
  "name": "issus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-app.mjs",
    "test": "node ../../scripts/run-tests.mjs src --allow-empty",
    "lint": "tsc --noEmit -p tsconfig.json",
    "build:front": "vite build",
    "build:server": "node ../../scripts/build-app.mjs --server-only",
    "test:integration": "node ../../scripts/run-tests.mjs tests/integration",
    "test:browser": "node ../../scripts/run-tests.mjs tests/browser"
  },
  "dependencies": {
    "issus_domain": "0.1.0",
    "agent": "0.1.0-issus.1",
    "issus_runtime": "0.1.0",
    "express": "5.3.0",
    "env-schema": "8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "playwright": "1.59.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "ws": "8.22.0"
  }
}
